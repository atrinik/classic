{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/integrated-linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "PACKAGE_TYPE": "none"
      }
    },
    {
      "name": "linux-release",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/integrated-linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-coverage",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/integrated-linux-coverage",
      "cacheVariables": {
        "ENABLE_COVERAGE": true,
        "ATRINIK_SERVER_ENABLE_PRECOMPILED_HEADERS": false
      }
    },
    {
      "name": "linux-sanitizers",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/integrated-linux-sanitizers",
      "cacheVariables": {
        "ENABLE_SANITIZERS": true
      }
    }
  ],
  "buildPresets": [
    {"name": "linux-debug", "configurePreset": "linux-debug"},
    {"name": "linux-release", "configurePreset": "linux-release"},
    {"name": "linux-coverage", "configurePreset": "linux-coverage"},
    {"name": "linux-sanitizers", "configurePreset": "linux-sanitizers"}
  ],
  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "linux-coverage",
      "configurePreset": "linux-coverage",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "linux-sanitizers",
      "configurePreset": "linux-sanitizers",
      "output": {"outputOnFailure": true}
    }
  ]
}
