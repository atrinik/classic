# Validate the public socket.h dependency before configuring consumers. Resolve
# each header in include order so a later SDK cannot hide an incompatible one.
function(atrinik_require_classic_protocol)
    get_target_property(include_dirs Atrinik::Protocol INTERFACE_INCLUDE_DIRECTORIES)
    foreach (header IN ITEMS game_commands talk rendezvous_admission)
        unset(selected_${header})
        foreach (include_dir IN LISTS include_dirs)
            if (include_dir MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
                set(include_dir "${CMAKE_MATCH_1}")
            elseif (include_dir MATCHES "^\\$<")
                continue()
            endif ()
            if (EXISTS "${include_dir}/atrinik/protocol/${header}.h")
                set(selected_${header} "${include_dir}/atrinik/protocol/${header}.h")
                break()
            endif ()
        endforeach ()
        if (NOT selected_${header})
            message(FATAL_ERROR
                "Selected Atrinik::Protocol lacks required ${header}.h; "
                "libatrinik requires Classic protocol revision >=1084 with canonical TALK modes "
                "and rendezvous admission. Use matching sibling, embedded, explicit-source, or "
                "installed Classic protocol sources; the historical v1.0.0 lock is incompatible.")
        endif ()
    endforeach ()
    file(READ "${selected_game_commands}" commands)
    string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" commands "${commands}")
    string(REGEX REPLACE "//[^\n]*" "" commands "${commands}")
    if (NOT commands MATCHES "(^|\n)[ \t]*#define[ \t]+ATRINIK_PROTOCOL_VERSION[ \t]+([0-9]+)U?[ \t]*(\n|$)")
        message(FATAL_ERROR "Selected Atrinik::Protocol has no canonical game revision definition")
    endif ()
    if (CMAKE_MATCH_2 LESS 1084)
        message(FATAL_ERROR "Selected Atrinik::Protocol game revision must be >=1084 for public TALK definitions")
    endif ()
    set(mode 1)
    foreach (name IN ITEMS NPC INV BELOW CONTAINER NPC_NAME CLOSE NPC_TARGET)
        if (NOT commands MATCHES "(^|\n)[ \t]*CMD_TALK_${name}[ \t]*=[ \t]*${mode}[ \t]*,")
            message(FATAL_ERROR "Selected Atrinik::Protocol lacks canonical CMD_TALK_${name} = ${mode}")
        endif ()
        math(EXPR mode "${mode} + 1")
    endforeach ()
    if (NOT commands MATCHES "(^|\n)[ \t]*#define[ \t]+TALK_NPC_TARGET_MESSAGE_MAX[ \t]+4095U?[ \t]*(\n|$)")
        message(FATAL_ERROR "Selected Atrinik::Protocol lacks the canonical TALK message bound")
    endif ()
    file(READ "${selected_talk}" talk)
    string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" talk "${talk}")
    string(REGEX REPLACE "//[^\n]*" "" talk "${talk}")
    if (NOT talk MATCHES "(^|\n)[ \t]*#define[ \t]+TALK_NPC_TARGET_FIXED_SIZE[ \t]+8U?[ \t]*(\n|$)")
        message(FATAL_ERROR "Selected Atrinik::Protocol lacks the canonical TALK fixed framing")
    endif ()
endfunction()
