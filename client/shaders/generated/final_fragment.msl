#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> final_albedo [[texture(0)]], texture2d<uint> final_owner [[texture(1)]], sampler final_sampler [[sampler(0)]], float4 gl_FragCoord [[position]])
{
    main0_out out = {};
    out.out_var_SV_Target0 = select(final_albedo.sample(final_sampler, in.in_var_TEXCOORD0), float4(0.0), bool4(final_owner.read(uint2(int3(int(gl_FragCoord.x), int(gl_FragCoord.y), 0).xy), 0).x == 255u));
    return out;
}

