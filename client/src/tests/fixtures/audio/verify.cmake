file(STRINGS "${CHECKSUM_FILE}" CHECKSUM_LINES LIMIT_COUNT 1)
list(GET CHECKSUM_LINES 0 CHECKSUM_LINE)
string(REGEX MATCH "^[0-9a-fA-F]+" EXPECTED_SHA256 "${CHECKSUM_LINE}")
string(LENGTH "${EXPECTED_SHA256}" CHECKSUM_LENGTH)
if(NOT CHECKSUM_LENGTH EQUAL 64)
    message(FATAL_ERROR "Invalid SHA-256 checksum in ${CHECKSUM_FILE}")
endif()

file(SHA256 "${FIXTURE}" ACTUAL_SHA256)
if(NOT ACTUAL_SHA256 STREQUAL EXPECTED_SHA256)
    message(FATAL_ERROR
        "Audio fixture checksum mismatch: expected ${EXPECTED_SHA256}, got ${ACTUAL_SHA256}")
endif()
