#ifndef VERSION_H
#define VERSION_H

/* Name of the package. */
#define PACKAGE_NAME "@PACKAGE_NAME@"

/* Major version of the package. */
#define PACKAGE_VERSION_MAJOR @PACKAGE_VERSION_MAJOR@

/* Minor version of the package. */
#define PACKAGE_VERSION_MINOR @PACKAGE_VERSION_MINOR@

/* Patch version of the package. */
#define PACKAGE_VERSION_PATCH @PACKAGE_VERSION_PATCH@

/* Reproducibility coordinates embedded by the configuring toolchain. */
#define ATRINIK_BUILD_TYPE "@ATRINIK_BUILD_TYPE@"
#define ATRINIK_COMPILER_ID "@ATRINIK_COMPILER_ID@"
#define ATRINIK_COMPILER_VERSION "@ATRINIK_COMPILER_VERSION@"
#define ATRINIK_SYSTEM_NAME "@ATRINIK_SYSTEM_NAME@"
#define ATRINIK_BENCHMARK_REVISION "@ATRINIK_BENCHMARK_REVISION@"
#define ATRINIK_BENCHMARK_DIRTY "@ATRINIK_BENCHMARK_DIRTY@"

#endif
