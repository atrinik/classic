* text=auto

# Large binary assets use Git LFS for new paths.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.opus filter=lfs diff=lfs merge=lfs -text
*.mid filter=lfs diff=lfs merge=lfs -text
*.midi filter=lfs diff=lfs merge=lfs -text
*.mod filter=lfs diff=lfs merge=lfs -text
*.s3m filter=lfs diff=lfs merge=lfs -text
*.xm filter=lfs diff=lfs merge=lfs -text
*.it filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.woff filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# Existing Classic assets remain ordinary Git until a Classic-specific migration.
client/textures/** -filter binary
client/fonts/** -filter binary
client/src/tests/fixtures/audio/*.mid -filter binary
docs/history/*-commit-map.txt linguist-generated=true

# Module release bookkeeping is not part of exported source archives.
client/.github export-ignore
client/.github/** export-ignore
client/.releaserc.json export-ignore
client/release-line.txt export-ignore
client/tools/package-release.sh export-ignore
server/.github export-ignore
server/.github/** export-ignore
server/.releaserc.json export-ignore
server/release-line.txt export-ignore
server/tools/package-release.sh export-ignore
editor/.github export-ignore
editor/.github/** export-ignore
editor/.releaserc.json export-ignore
libatrinik/.github export-ignore
libatrinik/.github/** export-ignore
libatrinik/.releaserc.json export-ignore
libatrinik/release-line.txt export-ignore
libatrinik/tools/package-release.sh export-ignore
protocol/.github export-ignore
protocol/.github/** export-ignore
protocol/.releaserc.json export-ignore
protocol/release-line.txt export-ignore
protocol/tools/package-release.sh export-ignore
