{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "ENABLE_PYTHON_PLUGIN": true,
        "PACKAGE_TYPE": "none"
      }
    },
    {
      "name": "linux-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "ENABLE_PYTHON_PLUGIN": true,
        "PACKAGE_TYPE": "none"
      }
    },
    {
      "name": "linux-coverage",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/linux-coverage",
      "cacheVariables": {
        "ENABLE_COVERAGE": true
      }
    },
    {
      "name": "llvm-coverage",
      "inherits": "linux-coverage",
      "binaryDir": "${sourceDir}/build/llvm-coverage",
      "cacheVariables": {
        "ENABLE_PRECOMPILED_HEADERS": false
      }
    },
    {
      "name": "linux-sanitizers",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/linux-sanitizers",
      "cacheVariables": {
        "ENABLE_SANITIZERS": true
      }
    }
  ],
  "buildPresets": [
    {"name": "linux-debug", "configurePreset": "linux-debug"},
    {"name": "linux-sanitizers", "configurePreset": "linux-sanitizers"},
    {"name": "linux-coverage", "configurePreset": "linux-coverage"},
    {"name": "llvm-coverage", "configurePreset": "llvm-coverage"},
    {"name": "linux-release", "configurePreset": "linux-release"}
  ],
  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {"outputOnFailure": true},
      "execution": {"jobs": 4}
    },
    {
      "name": "linux-sanitizers",
      "configurePreset": "linux-sanitizers",
      "output": {"outputOnFailure": true},
      "execution": {"jobs": 4}
    },
    {
      "name": "linux-coverage",
      "configurePreset": "linux-coverage",
      "output": {"outputOnFailure": true},
      "execution": {"jobs": 4}
    },
    {
      "name": "llvm-coverage",
      "inherits": "linux-coverage",
      "configurePreset": "llvm-coverage",
      "environment": {"LLVM_PROFILE_FILE": "${sourceDir}/build/llvm-coverage/llvm-profiles/%m-%p.profraw"},
      "execution": {"jobs": 4}
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {"outputOnFailure": true},
      "execution": {"jobs": 4}
    }
  ]
}
