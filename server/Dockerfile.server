FROM ubuntu:26.04 AS build

ARG ATRINIK_PACKAGE_VERSION=1.0.0

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        check \
        cmake \
        flex \
        git \
        libcurl4-openssl-dev \
        libgd-dev \
        libminiupnpc-dev \
        libreadline-dev \
        libsubunit-dev \
        libssl-dev \
        pkgconf \
        python3-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

RUN python3 tools/dependencies.py sync

RUN ATRINIK_PACKAGE_VERSION="${ATRINIK_PACKAGE_VERSION}" \
    cmake -S . -B build/server-release \
        -DCMAKE_BUILD_TYPE=Release \
        -DPACKAGE_VERSION="${ATRINIK_PACKAGE_VERSION}" \
        -DPACKAGE_TYPE=none \
    && cmake --build build/server-release \
        --target atrinik-server plugin_arena \
        --parallel

RUN ./tools/prepare-runtime.sh build/server-release \
    && cp -R install_data /tmp/atrinik-data \
    && mkdir -p /tmp/atrinik-data/tmp /tmp/atrinik-data/http \
    && ./atrinik-server \
        --worldmaker \
        --datapath=/tmp/atrinik-data \
        --httppath=/tmp/atrinik-data/http \
        --http_server=off \
    && mkdir -p install_data/http \
    && cp -R /tmp/atrinik-data/http/client-maps install_data/http/

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive \
    ATRINIK_HTTP_URL=off

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libcrypt1 \
        libcurl4t64 \
        libgd3 \
        libminiupnpc21 \
        libpython3.14 \
        libreadline8t64 \
        libssl3t64 \
        libsubunit0 \
        python3 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 atrinik

WORKDIR /opt/atrinik

COPY --from=build /src/runtime/content/maps ./server/maps
RUN rm -f ./server/maps/python/events/init/documentation.py
COPY --from=build /src/atrinikloop.sh ./server/atrinikloop.sh
COPY --from=build /src/ca-bundle.crt ./server/ca-bundle.crt
COPY --from=build /src/install_data ./server/install_data
COPY --from=build /src/runtime/content/lib ./server/lib
COPY --from=build /src/permissions.cfg ./server/permissions.cfg
COPY --from=build /src/resources ./server/resources
COPY --from=build /src/server.cfg ./server/server.cfg
COPY --from=build /src/tools ./server/tools
COPY --from=build /src/build/server-release/atrinik-server ./server/atrinik-server
COPY --from=build /src/build/server-release/libplugin_arena.so ./server/libplugin_arena.so
COPY --from=build /src/build/server-release/libplugin_python.so ./server/libplugin_python.so
COPY --chmod=0755 docker/server-entrypoint.sh /usr/local/bin/atrinik-server-entrypoint
COPY --chmod=0755 docker/server-healthcheck.sh /usr/local/bin/atrinik-server-healthcheck

RUN mkdir -p server/data \
    && chown -R atrinik:atrinik /opt/atrinik

USER atrinik
WORKDIR /opt/atrinik/server

EXPOSE 1730/udp 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["/usr/local/bin/atrinik-server-healthcheck"]

ENTRYPOINT ["atrinik-server-entrypoint"]
