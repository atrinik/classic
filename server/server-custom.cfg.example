# Copy this file to server-custom.cfg before starting the server.
# Values here override server/server.cfg.

[general]

# Do not grant development/operator permissions to every player on a public
# server.
default_permission_groups = None
python_reload_modules = off

# Leave http_url set to 'off' for direct QUIC asset delivery, or deploy a
# separate HTTPS origin/CDN and set its base URL for a large dedicated server.
# Publish the exact asset snapshot first and use a public URL without embedded
# credentials, query parameters, or a fragment.
# http_url = https://cdn.example.com/atrinik

# Optional public-server identity:
# server_name = My Atrinik Server
# server_desc = A community Atrinik server.
# metaserver_hostname = play.example.net
# This optionally advertises a canonical DNS hostname for the QUIC endpoint;
# port_quic is published alongside it.
# Leave it unset for an addressless rendezvous-only listing. The legacy
# server_host numeric-IP option is retained for compatibility but is not
# published.
# Automatic PCP/NAT-PMP/UPnP mapping is enabled by default. Set this only when
# direct addressing or an externally managed route is intentional.
# port_mapping = off
