/* Server-owned handlers for client-to-server classic game protocol commands. */

ATRINIK_SERVER_COMMAND_HANDLER(CONTROL, socket_command_control, CONTROL, false)
ATRINIK_SERVER_COMMAND_HANDLER(ASK_FACE, socket_command_ask_face, ADMITTED, false)
ATRINIK_SERVER_COMMAND_HANDLER(SETUP, socket_command_setup, SETUP, false)
ATRINIK_SERVER_COMMAND_HANDLER(VERSION, socket_command_version, VERSION, false)
ATRINIK_SERVER_COMMAND_HANDLER(CLEAR, socket_command_clear, PLAYING, false)
ATRINIK_SERVER_COMMAND_HANDLER(REQUEST_UPDATE, socket_command_request_update, LOGIN, false)
ATRINIK_SERVER_COMMAND_HANDLER(KEEPALIVE, socket_command_keepalive, LIVENESS, false)
ATRINIK_SERVER_COMMAND_HANDLER(ACCOUNT, socket_command_account, LOGIN, false)
ATRINIK_SERVER_COMMAND_HANDLER(ITEM_EXAMINE, socket_command_item_examine, PLAYING, true)
ATRINIK_SERVER_COMMAND_HANDLER(ITEM_APPLY, socket_command_item_apply, PLAYING, true)
ATRINIK_SERVER_COMMAND_HANDLER(ITEM_MOVE, socket_command_item_move, PLAYING, true)
ATRINIK_SERVER_COMMAND_HANDLER(ASK_RESOURCE, socket_command_ask_resource, PLAYING, true)
ATRINIK_SERVER_COMMAND_HANDLER(PLAYER_CMD, socket_command_player_cmd, PLAYING, true)
ATRINIK_SERVER_COMMAND_HANDLER(ITEM_LOCK, socket_command_item_lock, PLAYING, true)
ATRINIK_SERVER_COMMAND_HANDLER(ITEM_MARK, socket_command_item_mark, PLAYING, true)
ATRINIK_SERVER_COMMAND_HANDLER(FIRE, socket_command_fire, PLAYING, true)
ATRINIK_SERVER_COMMAND_HANDLER(QUICKSLOT, socket_command_quickslot, PLAYING, true)
ATRINIK_SERVER_COMMAND_HANDLER(QUESTLIST, socket_command_quest_list, PLAYING, true)
ATRINIK_SERVER_COMMAND_HANDLER(MOVE_PATH, socket_command_move_path, PLAYING, true)
ATRINIK_SERVER_COMMAND_HANDLER(COMBAT, socket_command_combat, PLAYING, true)
ATRINIK_SERVER_COMMAND_HANDLER(TALK, socket_command_talk, PLAYING, true)
ATRINIK_SERVER_COMMAND_HANDLER(MOVE, socket_command_move, PLAYING, true)
ATRINIK_SERVER_COMMAND_HANDLER(TARGET, socket_command_target, PLAYING, true)
